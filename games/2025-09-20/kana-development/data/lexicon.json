{
  "meta": {
    "version": 2,
    "locale": "ja-JP",
    "notes": "N5-friendly core lexicon split into base/daku/handaku sets. 8 words per stage."
  },
  "words": [
    {
      "id": "ai",
      "kana": "あい",
      "romaji": "ai",
      "gloss_en": "love; affection",
      "jlpt": "N5",
      "tags": ["core", "vowels"],
      "worlds": ["1-base"],
      "audio": "",
      "note": "Often used in formal or literary contexts. In daily life, 「好き (suki)」 is more common for 'like/love'.",
      "example": { "kana": "愛を感じる", "romaji": "ai wo kanjiru", "english": "to feel love" }
    },
    {
      "id": "iie",
      "kana": "いいえ",
      "romaji": "iie",
      "gloss_en": "no",
      "jlpt": "N5",
      "tags": ["core", "vowels", "phrase"],
      "worlds": ["1-base"],
      "audio": "",
      "note": "Polite way to say 'no'. In casual speech, people often use ううん (uun).",
      "example": { "kana": "いいえ、違います", "romaji": "iie, chigaimasu", "english": "No, that’s not correct" }
    },
    {
      "id": "ue",
      "kana": "うえ",
      "romaji": "ue",
      "gloss_en": "up; above",
      "jlpt": "N5",
      "tags": ["core", "vowels", "direction"],
      "worlds": ["1-base"],
      "audio": "",
      "note": "Can mean 'on top of' or 'above'. Opposite is した (shita, below).",
      "example": { "kana": "机の上", "romaji": "tsukue no ue", "english": "on the desk" }
    },
    {
      "id": "ie",
      "kana": "いえ",
      "romaji": "ie",
      "gloss_en": "house; home",
      "jlpt": "N5",
      "tags": ["core", "vowels", "place"],
      "worlds": ["1-base"],
      "audio": "",
      "note": "「家 (ie)」 is neutral. 「うち (uchi)」 is more casual/familiar for 'home'.",
      "example": { "kana": "家に帰る", "romaji": "ie ni kaeru", "english": "to return home" }
    },
    {
      "id": "ao",
      "kana": "あお",
      "romaji": "ao",
      "gloss_en": "blue (noun)",
      "jlpt": "N5",
      "tags": ["core", "vowels", "color"],
      "worlds": ["1-base"],
      "audio": "",
      "note": "Historically covers both blue and green. For green, 「緑 (midori)」 is also used.",
      "example": { "kana": "青い空", "romaji": "aoi sora", "english": "blue sky" }
    },
    {
      "id": "aoi",
      "kana": "あおい",
      "romaji": "aoi",
      "gloss_en": "blue (adjective)",
      "jlpt": "N5",
      "tags": ["core", "vowels", "color"],
      "worlds": ["1-base"],
      "audio": "",
      "note": "Adjective form of 青. Can also describe someone’s face as pale.",
      "example": { "kana": "青いシャツ", "romaji": "aoi shatsu", "english": "blue shirt" }
    },
    {
      "id": "au",
      "kana": "あう",
      "romaji": "au",
      "gloss_en": "to meet",
      "jlpt": "N5",
      "tags": ["core", "vowels", "verb"],
      "worlds": ["1-base"],
      "audio": "",
      "note": "Used for meeting people. Usually with に particle.",
      "example": { "kana": "友だちに会う", "romaji": "tomodachi ni au", "english": "to meet a friend" }
    },
    {
      "id": "iu",
      "kana": "いう",
      "romaji": "iu",
      "gloss_en": "to say",
      "jlpt": "N5",
      "tags": ["core", "vowels", "verb"],
      "worlds": ["1-base"],
      "audio": "",
      "note": "General verb for 'say/tell'. Often paired with と particle.",
      "example": { "kana": "彼は「こんにちは」と言った", "romaji": "kare wa 'konnichiwa' to itta", "english": "He said 'hello'." }
    },

    {
      "id": "iku",
      "kana": "いく",
      "romaji": "iku",
      "gloss_en": "to go",
      "jlpt": "N5",
      "tags": ["core", "k-row", "verb"],
      "worlds": ["2-base"],
      "audio": "",
      "note": "Basic motion verb. Irregular past form: いった (itta).",
      "example": { "kana": "学校に行く", "romaji": "gakkou ni iku", "english": "to go to school" }
    },
    {
      "id": "kiku",
      "kana": "きく",
      "romaji": "kiku",
      "gloss_en": "to listen; to ask",
      "jlpt": "N5",
      "tags": ["core", "k-row", "verb"],
      "worlds": ["2-base"],
      "audio": "",
      "note": "Context decides: with 音楽 → 'listen', with 質問 → 'ask'.",
      "example": { "kana": "音楽を聞く", "romaji": "ongaku wo kiku", "english": "to listen to music" }
    },
    {
      "id": "kau",
      "kana": "かう",
      "romaji": "kau",
      "gloss_en": "to buy",
      "jlpt": "N5",
      "tags": ["core", "k-row", "verb"],
      "worlds": ["2-base"],
      "audio": "",
      "note": "Everyday verb, often with を particle.",
      "example": { "kana": "本を買う", "romaji": "hon wo kau", "english": "to buy a book" }
    },
    {
      "id": "kao",
      "kana": "かお",
      "romaji": "kao",
      "gloss_en": "face",
      "jlpt": "N5",
      "tags": ["core", "k-row", "body"],
      "worlds": ["2-base"],
      "audio": "",
      "note": "Used in expressions like 顔色 (kaoiro, complexion).",
      "example": { "kana": "顔が赤い", "romaji": "kao ga akai", "english": "face is red" }
    },
    {
      "id": "ike",
      "kana": "いけ",
      "romaji": "ike",
      "gloss_en": "pond",
      "jlpt": "N5",
      "tags": ["core", "k-row", "place"],
      "worlds": ["2-base"],
      "audio": "",
      "note": "Refers to small, often man-made ponds.",
      "example": { "kana": "池の魚", "romaji": "ike no sakana", "english": "the pond’s fish" }
    },
    {
      "id": "koe",
      "kana": "こえ",
      "romaji": "koe",
      "gloss_en": "voice",
      "jlpt": "N5",
      "tags": ["core", "k-row"],
      "worlds": ["2-base"],
      "audio": "",
      "note": "Refers to human/animal voices. Different from 音 (oto, sound).",
      "example": { "kana": "きれいな声", "romaji": "kirei na koe", "english": "a beautiful voice" }
    },
    {
      "id": "aka",
      "kana": "あか",
      "romaji": "aka",
      "gloss_en": "red",
      "jlpt": "N5",
      "tags": ["core", "k-row", "color"],
      "worlds": ["2-base"],
      "audio": "",
      "note": "Noun form of 'red'. Adjective form is あかい (akai).",
      "example": { "kana": "赤が好きです", "romaji": "aka ga suki desu", "english": "I like red" }
    },
    {
      "id": "oku",
      "kana": "おく",
      "romaji": "oku",
      "gloss_en": "inner part; back",
      "jlpt": "N5",
      "tags": ["core", "k-row", "place"],
      "worlds": ["2-base"],
      "audio": "",
      "note": "Refers to deep or inner areas (e.g., inside shops/rooms).",
      "example": { "kana": "部屋の奥", "romaji": "heya no oku", "english": "the back of the room" }
    },

    {
      "id": "eiga",
      "kana": "えいが",
      "romaji": "eiga",
      "gloss_en": "movie; film",
      "jlpt": "N5",
      "tags": ["core", "g-row", "topic"],
      "worlds": ["2-daku"],
      "audio": "",
      "note": "Common word, often with 見る (to watch).",
      "example": { "kana": "映画を見る", "romaji": "eiga wo miru", "english": "to watch a movie" }
    },
    {
      "id": "gaikoku",
      "kana": "がいこく",
      "romaji": "gaikoku",
      "gloss_en": "foreign country",
      "jlpt": "N5",
      "tags": ["core", "g-row", "place"],
      "worlds": ["2-daku"],
      "audio": "",
      "note": "Literally 'outside country'.",
      "example": { "kana": "外国に行く", "romaji": "gaikoku ni iku", "english": "to go abroad" }
    },
    {
      "id": "gakusei",
      "kana": "がくせい",
      "romaji": "gakusei",
      "gloss_en": "student",
      "jlpt": "N5",
      "tags": ["core", "g-row", "person"],
      "worlds": ["2-daku"],
      "audio": "",
      "note": "Usually refers to university students. For younger students, 生徒 (seito) is used.",
      "example": { "kana": "大学生です", "romaji": "daigakusei desu", "english": "I’m a university student" }
    },
    {
      "id": "gakkou",
      "kana": "がっこう",
      "romaji": "gakkou",
      "gloss_en": "school",
      "jlpt": "N5",
      "tags": ["core", "g-row", "place"],
      "worlds": ["2-daku"],
      "audio": "",
      "note": "General word for school. Modified as 小学校 (elementary school), etc.",
      "example": { "kana": "学校に行く", "romaji": "gakkou ni iku", "english": "to go to school" }
    },
    {
      "id": "ginkou",
      "kana": "ぎんこう",
      "romaji": "ginkou",
      "gloss_en": "bank",
      "jlpt": "N5",
      "tags": ["core", "g-row", "place"],
      "worlds": ["2-daku"],
      "audio": "",
      "note": "Used in places like 銀行員 (bank worker).",
      "example": { "kana": "銀行で働く", "romaji": "ginkou de hataraku", "english": "to work at a bank" }
    },
    {
      "id": "genki",
      "kana": "げんき",
      "romaji": "genki",
      "gloss_en": "healthy; energetic",
      "jlpt": "N5",
      "tags": ["core", "g-row", "adjective"],
      "worlds": ["2-daku"],
      "audio": "",
      "note": "Also used in greetings: お元気ですか？ (How are you?).",
      "example": { "kana": "元気です！", "romaji": "genki desu!", "english": "I’m fine!" }
    },
    {
      "id": "getsuyoubi",
      "kana": "げつようび",
      "romaji": "getsuyoubi",
      "gloss_en": "Monday",
      "jlpt": "N5",
      "tags": ["core", "g-row", "time"],
      "worlds": ["2-daku"],
      "audio": "",
      "note": "One of the days of the week. Literally 'moon-day'.",
      "example": { "kana": "月曜日に会う", "romaji": "getsuyoubi ni au", "english": "to meet on Monday" }
    },
    {
      "id": "guramu",
      "kana": "ぐらむ",
      "romaji": "guramu",
      "gloss_en": "gram (unit of weight)",
      "jlpt": "N5",
      "tags": ["loanword", "g-row"],
      "worlds": ["2-daku"],
      "audio": "",
      "note": "Loanword from English 'gram'. Used in cooking/shopping.",
      "example": { "kana": "100グラムの肉", "romaji": "hyaku guramu no niku", "english": "100 grams of meat" }
    }
  ],
