    {
      "id": "ai",
      "kana": "あい",
      "romaji": "ai",
      "gloss_en": "love; affection",
      "jlpt": "N5",
      "tags": ["core", "vowels"],
      "worlds": ["1-base"],
      "audio": "",
      "note": "Often used in formal or literary contexts. In daily life, 「すき (suki)」 is more common for 'like/love'.",
      "example": { "kana": "あいをかんじる", "romaji": "ai wo kanjiru", "english": "to feel love" }
    },
    {
      "id": "iie",
      "kana": "いいえ",
      "romaji": "iie",
      "gloss_en": "no",
      "jlpt": "N5",
      "tags": ["core", "vowels", "phrase"],
      "worlds": ["1-base"],
      "audio": "",
      "note": "Polite way to say 'no'. In casual speech, people often use ううん (uun).",
      "example": { "kana": "いいえ、ちがいます", "romaji": "iie, chigaimasu", "english": "No, that’s not correct" }
    },
    {
      "id": "ue",
      "kana": "うえ",
