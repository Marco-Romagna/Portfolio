      "worlds": ["1-base"],
      "audio": "",
      "note": "「いえ (ie)」 is neutral. 「うち (uchi)」 is more casual/familiar for 'home'.",
      "example": { "kana": "いえにかえる", "romaji": "ie ni kaeru", "english": "to return home" }
    },
