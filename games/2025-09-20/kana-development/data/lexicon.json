      "gloss_en": "up; above",
      "jlpt": "N5",
      "tags": ["core", "vowels", "direction"],
      "worlds": ["1-base"],
      "audio": "",
      "note": "Can mean 'on top of' or 'above'. Opposite is した (shita, below).",
      "example": { "kana": "つくえのうえ", "romaji": "tsukue no ue", "english": "on the desk" }
    },
    {
