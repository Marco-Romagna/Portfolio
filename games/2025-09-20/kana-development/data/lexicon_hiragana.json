    {"id":"tegami_hira","kana":"てがみ","romaji":"tegami","gloss_en":"letter","tags":["core","t-row","object"],"worlds":["4-base-hira"],"audio":"","note":"Means a handwritten letter. Common word in beginner vocab.","example":{"kana":"てがみをかく","romaji":"tegami wo kaku","english":"to write a letter"}},
    {"id":"tomodachi_hira","kana":"ともだち","romaji":"tomodachi","gloss_en":"friend","tags":["core","t-row","person"],"worlds":["4-base-hira"],"audio":"","note":"General word for 'friend'. Often shortened to とも.","example":{"kana":"ともだちにあう","romaji":"tomodachi ni au","english":"to meet a friend"}},
    {"id":"tokei_hira","kana":"とけい","romaji":"tokei","gloss_en":"clock; watch","tags":["core","t-row","object"],"worlds":["4-base-hira"],"audio":"","note":"Means both clocks and wristwatches. Written 時計 in kanji.","example":{"kana":"とけいをみる","romaji":"tokei wo miru","english":"to look at a clock"}},
    {"id":"densha_hira","kana":"でんしゃ","romaji":"densha","gloss_en":"train","tags":["core","d-row","transport"],"worlds":["4-daku-hira"],"audio":"","note":"Common everyday transport word. Written 電車 in kanji.","example":{"kana":"でんしゃにのる","romaji":"densha ni noru","english":"to ride a train"}},
    {"id":"daigaku_hira","kana":"だいがく","romaji":"daigaku","gloss_en":"university","tags":["core","d-row","place"],"worlds":["4-daku-hira"],"audio":"","note":"Refers to university/college. Often combined, e.g. 東京大学 (University of Tokyo).","example":{"kana":"だいがくにいく","romaji":"daigaku ni iku","english":"to go to university"}},
